# Frontend environment (copy to .env in project root)
# Optional — only needed for split hosting (e.g. Vercel frontend + Railway backend)

# Backend API URL (omit in local dev; Vite proxies /api to localhost:3001)
# VITE_API_URL=https://your-backend.example.com

# Razorpay public key for billing checkout UI
# VITE_RAZORPAY_KEY_ID=

# Override dev proxy target (default: http://localhost:3001)
# VITE_DEV_BACKEND_URL=http://localhost:3001

# Local screenshots taken while building the marketing pages (26 MB and growing).
screenshots/

# Leftover pytest working directories from an older harness. They are locked by the OS and
# cannot be removed from here; ignoring them keeps git status readable until they are cleared
# manually. Nothing writes new ones.
.test-tmp-*/

REPLICATE_API_TOKEN=your_replicate_token_here
GROQ_API_KEY=your_groq_api_key_here
# Groq vision model for captioning/OCR/prompt building. Must accept image input and
# return clean text (no <think> blocks). Override if the default is retired.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# App origin only (no path). Google OAuth returns to {FRONTEND_URL}/login
FRONTEND_URL=http://localhost:5173
# Public API origin used in share Open Graph links (https://api.rimiai.pro in production)
PUBLIC_API_URL=http://localhost:3001
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
# Must match an Authorized redirect URI in Google Cloud Console (OAuth Web client)
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
JWT_SECRET=your_jwt_secret_here
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,https://rimiai.pro,https://www.rimiai.pro
# protocol=2 = RESP2 (required for Redis 5.x; also works on Redis 6/7/8 / Railway)
RATELIMIT_STORAGE_URI=redis://localhost:6379/1?protocol=2
REDIS_URL=redis://localhost:6379/0?protocol=2
SENTRY_DSN=
RESEND_API_KEY=
EMAIL_FROM=RIMI AI <noreply@rimiai.pro>
SIGNUP_DEFAULT_CREDITS=200
SIGNUP_OTP_TTL_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# --- Payments -----------------------------------------------------------------
# REQUIRED for the Razorpay webhook. Without it /api/billing/razorpay-webhook rejects every
# delivery, and the only path that grants credits is the customer's browser returning from
# checkout. A customer who closes that tab is charged and receives nothing. Copy the value
# from Razorpay Dashboard > Settings > Webhooks after adding the endpoint.
RAZORPAY_WEBHOOK_SECRET=

# --- Runtime / deployment -----------------------------------------------------
# 'production' enables HSTS, requires Redis for rate limiting, and refuses a default JWT secret.
FLASK_ENV=development
PORT=3001
# Number of proxies in front of the app (Railway/nginx = 1, direct = 0). Used to derive the
# real client IP for rate limiting and the signup guard.
TRUSTED_PROXY_COUNT=0
# PostgreSQL connection string. Omit for local SQLite.
DATABASE_URL=
DB_POOL_MAX=20
# How long an authenticated user row is cached per process. Pro gates read entitlement fresh
# regardless of this value.
USER_CACHE_TTL_SECONDS=45

# --- Object storage (uploads + results) ---------------------------------------
# Required in production: Railway's disk is ephemeral, so without S3 every redeploy loses
# previously uploaded artwork and generated results.
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# --- Background jobs ----------------------------------------------------------
RQ_QUEUE_NAME=rimi-ai
RQ_MAX_RETRIES=3
QWEN_MAX_CONCURRENT_JOBS=2
JOB_IDEMPOTENCY_WINDOW_SEC=60
# Runs long jobs inline instead of on the queue. Never enable in production: a 30-120s
# generation would occupy a gunicorn request slot.
RIMI_SYNC_JOBS=false
RIMI_DISABLE_CLEANUP_SCHEDULER=false

# --- Model overrides ----------------------------------------------------------
# Must stay below the gunicorn timeout in gunicorn_config.py, otherwise a worker is killed
# before the refund path can run and the user keeps paying for work that was discarded.
REPLICATE_RUN_TIMEOUT=240
REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan
